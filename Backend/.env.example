# Copy to Backend/.env and replace placeholders with your own credentials.
# Never commit Backend/.env or real credentials.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/e-shop
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_account
# Additional integrations may require environment variables.
# Check the route and service modules before enabling those features.
